<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        ערכת הנושא של האפליקציה.
        DarkActionBar = יש פס עליון (ActionBar) — צריך אותו בשביל תפריטים
        ובשביל חץ החזרה לתפריט הפרק.

        השורות שמסתיימות ב-Style קובעות איך ייראה כל רכיב מסוג מסוים
        בכל המסכים, בלי לכתוב שום דבר בקובצי ה-XML של הפריסות.
    -->
    <style name="Base.Theme.App" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <item name="colorPrimary">@color/brand</item>
        <item name="colorPrimaryVariant">@color/brand_dark</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/bg</item>
        <item name="android:textColorPrimary">@color/text_main</item>
        <item name="android:textColorSecondary">@color/text_soft</item>

        <!-- עיצוב ברירת מחדל לכל הרכיבים -->
        <item name="materialButtonStyle">@style/App.Button</item>
        <item name="android:textViewStyle">@style/App.Text</item>
        <item name="editTextStyle">@style/App.Edit</item>
        <item name="android:listDivider">@color/divider</item>
    </style>

    <style name="Theme.App" parent="Base.Theme.App" />

    <!-- כפתור: גבוה יותר, פינות מעוגלות, בלי אותיות גדולות כפויות -->
    <style name="App.Button" parent="Widget.MaterialComponents.Button">
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0</item>
        <item name="cornerRadius">14dp</item>
    </style>

    <!-- טקסט: מרווח שורות נדיב, קריא הרבה יותר בעברית -->
    <style name="App.Text" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">16sp</item>
        <item name="android:lineSpacingExtra">5sp</item>
        <item name="android:textColor">@color/text_main</item>
    </style>

    <!-- שדה קלט -->
    <style name="App.Edit" parent="Widget.AppCompat.EditText">
        <item name="android:textSize">16sp</item>
        <item name="android:minHeight">50dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>

    <!-- סגנונות לשימוש ידני בפריסות -->
    <style name="App.Title" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">24sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">@color/text_main</item>
        <item name="android:paddingBottom">6dp</item>
    </style>

    <style name="App.Hint" parent="Widget.AppCompat.TextView">
        <item name="android:textSize">14sp</item>
        <item name="android:textColor">@color/text_soft</item>
        <item name="android:lineSpacingExtra">4sp</item>
    </style>

</resources>
